<layout version="0.1.0">
    <netseasy_payment_redirect>
        <reference name="root">
            <action method="setTemplate"><template>page/1column.phtml</template></action>
        </reference>
        <reference name="content">
            <block type="netseasy/redirect" name="netseasy.redirect" />
        </reference>
    </netseasy_payment_redirect>

    <netseasy_payment_checkout>
        <reference name="root">
            <action method="setTemplate"><template>page/1column.phtml</template></action>
        </reference>
        <reference name="content">
            <block type="netseasy/checkout" name="netseasy.checkout" />
        </reference>
    </netseasy_payment_checkout>
</layout>
